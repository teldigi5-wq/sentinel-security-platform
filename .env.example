# COPY to .env and replace all placeholders with output from:
#   python backend/scripts/generate_keys.py
# DO NOT use these placeholders as real credentials. DO NOT commit .env.
# Local compatibility only (legacy single shared credential). Remove once
# individual operators are configured; legacy is disabled when mapping exists.
# Choose 'database' only after migration and local admin enrollment.
# Database mode requires removing SENTINEL_OPERATOR_TOKEN and SENTINEL_OPERATORS.
SENTINEL_AUTH_MODE=static
SENTINEL_OPERATOR_TOKEN=CHANGE_ME
# Recommended: hash output from `python backend/scripts/generate_operator.py`.
# Set a JSON mapping, each operator having role and token_sha256 (no raw bearer tokens).
# SENTINEL_OPERATORS='{"alice": {"role": "analyst", "token_sha256": "64-lowercase-hex-chars"}}' 
SENTINEL_AUDIT_KEY=CHANGE_ME
SENTINEL_SENSOR_KEYS='{"lab-sensor-1":"CHANGE_ME"}'
# Recommended sensor-to-asset enrollment; include every configured sensor ID.
# SENTINEL_SENSOR_ASSETS='{"lab-sensor-1":"workstation-1"}'
SENTINEL_DATABASE_URL=sqlite:///./sentinel.db
SENTINEL_FRONTEND_ORIGINS=http://localhost:3000
