# Install only after following docs/LINUX_SERVICE.md. Does not auto-start on installation.
[Unit]
Description=SENTINEL read-only SSH authentication collector
Documentation=https://github.com/teldigi5-wq/sentinel-security-platform
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=sentinel-sensor
Group=sentinel-sensor
SupplementaryGroups=adm
EnvironmentFile=/etc/sentinel/collector.conf
StateDirectory=sentinel-sensor
StateDirectoryMode=0700
ExecStart=/opt/sentinel/venv/bin/python -m sentinel.collectors.linux_ssh --source /var/log/auth.log --state /var/lib/sentinel-sensor/ssh-cursor.json --asset ${SENTINEL_ASSET_ID} --sensor ${SENTINEL_SENSOR_ID} --sensor-key-file /etc/sentinel/collector.key --port 8000 --follow --interval 5 --heartbeat-seconds 60
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

[Install]
WantedBy=multi-user.target
